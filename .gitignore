# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# The ready-to-play Windows build is intentionally versioned for portfolio use.
# Do not store a duplicate archive of the same build.
/Build/Build.zip
/[Bb]uilds/

# Generated desktop WebGL release artifacts are validated locally and are not source assets.
/Build/WebGL/RobotArenaRelease/
/Build/WebGL/RobotArenaRelease-upload.zip
/Build/WebGL/RobotArenaRelease-report.json

# IDE and editor files
/.vs/
/.vscode/
/.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Unity / OS crash and diagnostic files
sysinfo.txt
crashlytics-build.properties
*.stackdump

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Keep Asset Store tools out of source control when generated locally
/Assets/AssetStoreTools*
